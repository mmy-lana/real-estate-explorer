# Application shell
VITE_APP_TITLE=Real Estate Explorer
VITE_DEFAULT_LOCALE=en-US
VITE_DEFAULT_CURRENCY=USD

# Pricing model (fraction of the nightly subtotal, e.g. 0.14 === 14%)
VITE_SERVICE_FEE_PERCENT=0.14

# Interaction tuning (milliseconds)
VITE_SEARCH_DEBOUNCE_MS=250

# Feature flags ("true" / "false")
VITE_ENABLE_MAP_CLUSTERING=true
VITE_ENABLE_URL_STATE_SYNC=true
